From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mercurious <dutch.money@gmail.com>
Date: Thu, 30 Jul 2026 19:43:13 -0400
Subject: [PATCH 6/8] KGSL-parity query-survive: forge zero instead of
 device-lost

Builds on the t3devlost per-object staleness detection. Where that patch
answers VK_ERROR_DEVICE_LOST so the app tears down cleanly (~1s stop),
this one is parity: when the paired ROCKNIX-GTK kernel keeps the hung
context alive (msm.context_keepalive=1, which neither bans the VM nor
bumps the fault counter), the dropped query can instead be forged --
reported AVAILABLE with value 0, one wrong fully-occluded frame -- so the
app's poll unparks and the race CONTINUES, matching how Android/KGSL
absorbs the same hang.

Gated by TU_ETK_QUERY_SURVIVE, DEFAULT ON, with TU_ETK_QUERY_SURVIVE=0 as
the kill-switch. Both dropped-query verdicts in get_query_pool_results --
the wait_for_available WAIT_BIT strike path and the PARTIAL/ZCULL-poke
staleness path -- get a survive branch that forges an available zero result
(WITH_AVAILABILITY still reports 1/done). ETK_SURVIVE_UNAVAIL_NS = 1.5s
doubles as the "submit was dropped" signal and bounds the stutter. Never
marks the device lost, so submits keep flowing.

Requires the parity kernel: without msm.context_keepalive the forged query
is followed by -EPIPE on the next submit. This is one half of a
kernel+driver pair, not standalone.

The default was originally off, on the reasoning that a new mechanism should
be opt-in. That was wrong as a record: the certified gtk_0.4 driver shipped
with it flipped ON, but the flip lived only as an uncommitted edit in the
build tree, so this published series did NOT reproduce the shipped driver --
a rebuild from these patches silently lost the survive net, which is exactly
what happened to gtk_0.5. Default-on makes the series honest about what the
proven build does; TU_ETK_QUERY_SURVIVE=0 recovers the old behaviour for A/B.
---
 src/freedreno/vulkan/tu_query_pool.cc | 78 +++++++++++++++++++++++++--
 1 file changed, 73 insertions(+), 5 deletions(-)

diff --git a/src/freedreno/vulkan/tu_query_pool.cc b/src/freedreno/vulkan/tu_query_pool.cc
index 6d3ea7d..c54f80f 100644
--- a/src/freedreno/vulkan/tu_query_pool.cc
+++ b/src/freedreno/vulkan/tu_query_pool.cc
@@ -12,6 +12,7 @@
 
 #include "nir/nir_builder.h"
 #include "util/os_time.h"
+#include "util/u_debug.h"
 #include "vk_acceleration_structure.h"
 #include "vk_util.h"
 
@@ -584,17 +585,48 @@ emit_counter_barrier(struct tu_cs *cs)
  * in practice (fork-local pragmatism; reset on every available query). */
 static uint32_t etk_wait_timeout_strikes = 0;
 
-/* Wait on the the availability status of a query up until a timeout. */
+/* KGSL parity — the userspace companion to the kernel's msm.context_keepalive
+ * (ETK mission d, 2026-07-05). When the kernel keeps a hung context alive
+ * (parity kernel, param on), the submit that hangcheck recovery SKIPPED never
+ * writes its query's availability word, so a poll on that query would spin
+ * forever. The stock GTK build (t3devlost2/4b below) breaks that spin by
+ * declaring the device lost — a clean tear-down (the crash-net). Survive mode
+ * instead forges an available, zero-valued result so the app's rsx poll
+ * unparks and the race CONTINUES — one wrong (fully-occluded) frame instead of
+ * a lost device, matching how Android/KGSL absorbs this same hang. DEFAULT ON:
+ * this is what the certified gtk_0.4 driver actually shipped, and a build from
+ * the published patch series has to reproduce that. TU_ETK_QUERY_SURVIVE=0 is
+ * the kill-switch back to the stock crash-net (t3devlost device-lost) for A/B. */
+static bool
+etk_query_survive(void)
+{
+   static int cached = -1;
+   if (cached < 0)
+      cached = debug_get_bool_option("TU_ETK_QUERY_SURVIVE", true);
+   return cached;
+}
+
+/* A healthy occlusion query resolves in ms; nothing legitimate stays
+ * unavailable this long on a working GPU, so this doubles as the "its submit
+ * was dropped" signal AND bounds the parity stutter to ~1.5 s. */
+#define ETK_SURVIVE_UNAVAIL_NS (1500ull * 1000 * 1000)
+
+/* Wait on the the availability status of a query up until a timeout.
+ * In survive mode, *etk_dropped is set true when the query is judged dropped
+ * (never coming) so the caller forges a zero result instead of losing the
+ * device. */
 static VkResult
 wait_for_available(struct tu_device *device, struct tu_query_pool *pool,
-                   uint32_t query)
+                   uint32_t query, bool *etk_dropped)
 {
    /* TODO: Use the MSM_IOVA_WAIT ioctl to wait on the available bit in a
     * scheduler friendly way instead of busy polling once the patch has landed
     * upstream. */
    struct query_slot *slot = slot_address(pool, query);
+   *etk_dropped = false;
+   bool survive = etk_query_survive();
    uint64_t abs_timeout = os_time_get_absolute_timeout(
-         WAIT_TIMEOUT * NSEC_PER_SEC);
+         survive ? ETK_SURVIVE_UNAVAIL_NS : (WAIT_TIMEOUT * NSEC_PER_SEC));
    /* ETK Tier-3 (787B reframe, 2026-07-04): consult device status while
     * waiting. After a kernel hangcheck recovery this query can never become
     * available; the stock path returned VK_TIMEOUT (nonconformant for
@@ -621,6 +653,15 @@ wait_for_available(struct tu_device *device, struct tu_query_pool *pool,
    VkResult device_status = vk_device_check_status(&device->vk);
    if (device_status != VK_SUCCESS)
       return device_status;
+   /* KGSL parity: the query's submit was dropped by a hangcheck recovery and
+    * will never post. Rather than declare the device lost, tell the caller to
+    * forge a zero result and continue (the ~1.5 s wait above already bounded
+    * the stutter). */
+   if (survive) {
+      *etk_dropped = true;
+      etk_wait_timeout_strikes = 0;
+      return VK_SUCCESS;
+   }
    /* ETK t3devlost2: kernel 7.0.11 does NOT advance MSM_PARAM_FAULTS for
     * hangcheck-class recoveries (verified live on the HSL boss: this loop's
     * 10 ms status checks ran for 90+ s against a flat counter while dmesg
@@ -701,6 +742,9 @@ get_query_pool_results(struct tu_device *device,
       bool available = query_is_available(slot);
       uint32_t result_count = get_result_count(pool);
       uint32_t statistics = pool->vk.pipeline_statistics;
+      /* KGSL parity: set when this query's submit was dropped by a hangcheck
+       * recovery — its result is forged to zero (see etk_query_survive). */
+      bool etk_forced_zero = false;
 
       /* ETK t3devlost4b: per-object staleness, flag-agnostic. v4 gated the
        * stamp behind !(flags & PARTIAL) — falsified live 2026-07-05: this
@@ -714,6 +758,16 @@ get_query_pool_results(struct tu_device *device,
          pool->etk_unavail_since_ns = 0;
       } else if (pool->etk_unavail_since_ns == 0) {
          pool->etk_unavail_since_ns = etk_now_ns;
+      } else if (etk_query_survive() &&
+                 etk_now_ns - pool->etk_unavail_since_ns >
+                    ETK_SURVIVE_UNAVAIL_NS) {
+         /* KGSL parity, partial/ZCULL-poke path (RPCS3 polls this query with
+          * PARTIAL|WITH_AVAILABILITY, so it never takes the WAIT_BIT branch
+          * below): the submit was dropped by a hangcheck recovery. Forge a
+          * zero result and continue instead of losing the device. */
+         etk_forced_zero = true;
+         available = true;
+         pool->etk_unavail_since_ns = 0;
       } else if (etk_now_ns - pool->etk_unavail_since_ns >
                  30ull * 1000 * 1000 * 1000) {
          return vk_device_set_lost(&device->vk,
@@ -723,10 +777,13 @@ get_query_pool_results(struct tu_device *device,
       }
 
       if ((flags & VK_QUERY_RESULT_WAIT_BIT) && !available) {
-         VkResult wait_result = wait_for_available(device, pool, query);
+         bool etk_dropped = false;
+         VkResult wait_result =
+            wait_for_available(device, pool, query, &etk_dropped);
          if (wait_result != VK_SUCCESS)
             return wait_result;
          available = true;
+         etk_forced_zero = etk_dropped;
       } else if (!(flags & VK_QUERY_RESULT_PARTIAL_BIT) && !available) {
          /* From the Vulkan 1.1.130 spec:
           *
@@ -745,7 +802,18 @@ get_query_pool_results(struct tu_device *device,
       }
 
       for (uint32_t k = 0; k < result_count; k++) {
-         if (available) {
+         if (available && etk_forced_zero) {
+            /* KGSL parity: dropped-submit query — its GPU result memory was
+             * never written (stale/garbage), so forge a valid zero rather than
+             * copy it out. Availability below still reports 1 (done). */
+            uint64_t zero = 0;
+            if (pool->vk.query_type == VK_QUERY_TYPE_PERFORMANCE_QUERY_KHR)
+               write_performance_query_value_cpu(
+                  result_base, k, VK_PERFORMANCE_COUNTER_STORAGE_UINT64_KHR,
+                  &zero);
+            else
+               write_query_value_cpu(result_base, k, &zero, flags);
+         } else if (available) {
             uint64_t *result;
 
             if (pool->vk.query_type == VK_QUERY_TYPE_PIPELINE_STATISTICS) {
