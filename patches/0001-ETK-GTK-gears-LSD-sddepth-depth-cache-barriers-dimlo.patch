+   ETK_DEBUG_FLAG_BITS
    TU_DEBUG_STARTUP                  = BITFIELD64_BIT(0),
    TU_DEBUG_NIR                      = BITFIELD64_BIT(1),
    TU_DEBUG_NOBIN                    = BITFIELD64_BIT(2),
