index cfa18f3..93d6bd3 100644
--- a/src/freedreno/vulkan/tu_util.h
+++ b/src/freedreno/vulkan/tu_util.h
@@ -10,6 +10,7 @@
 #define TU_UTIL_H
 
 #include "tu_common.h"
