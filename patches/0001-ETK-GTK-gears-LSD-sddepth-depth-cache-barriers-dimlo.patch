diff --git a/src/freedreno/vulkan/tu_etk_gears.h b/src/freedreno/vulkan/tu_etk_gears.h
new file mode 100644
index 0000000..79cc283
--- /dev/null
+++ b/src/freedreno/vulkan/tu_etk_gears.h
@@ -0,0 +1,112 @@
+/*
+ * Copyright © 2026 ETK (Emulation Tuning Kit)
+ * SPDX-License-Identifier: MIT
+ */
+
+/* ETK gear registry — every fork-added TU_DEBUG flag, in one place.
+ *
+ * WHY THIS FILE EXISTS
+ * --------------------
+ * The fork's gears used to register themselves inline, each patch editing
+ * `enum tu_debug_flags` (tu_util.h) and `tu_debug_options[]` /
+ * `tu_runtime_debug_flags` (tu_util.cc). That produced two failure modes, both
+ * observed for real while rebasing onto Mesa main (2026-08-03):
+ *
+ *   1. UPSTREAM CHURN. The ETK bits sat mid-enum, between upstream's bits 10
+ *      and 11 — maximum conflict surface. Any upstream edit near there broke
+ *      our hunks.
+ *
+ *   2. INTERNAL COUPLING. Because every patch appended to the same two lists,
+ *      patch N's diff context contained patch N-1's additions. The series
+ *      became an all-or-nothing ordered set: skip one gear and every later
+ *      patch failed to apply, even ones touching completely unrelated code.
+ *      Concretely, `zlatez` (a live experiment) could not be applied to main
+ *      because `dsany` (a falsified, droppable gear) was skipped ahead of it.
+ *
+ * Both are fixed by registering everything here, once, in the FIRST fork patch,
+ * and exposing it to the upstream files through three macros. Upstream files
+ * then carry ONE single-line insertion each instead of N multi-line hunks, and
+ * no fork patch's application depends on any other fork patch.
+ *
+ * A gear registered here with no implementation behind it is inert — it parses
+ * and sets a bit nobody reads. That is deliberate: it lets an individual gear
+ * patch be dropped on a base where it does not apply, without disturbing the
+ * rest of the series.
+ *
+ * This file is pure macro definition — no includes, no code. BITFIELD64_BIT
+ * resolves at the expansion site in tu_util.h.
+ *
+ * BIT ALLOCATION — ETK COUNTS DOWN FROM 63, UPSTREAM COUNTS UP FROM 0.
+ * The fork originally hard-coded 37+ "to stay clear of upstream, which is in
+ * the 30s". Upstream reached 37 in 26.2 (TU_DEBUG_COMPUTE_ROUND_ROBIN) and
+ * silently aliased TU_DEBUG_SDDEPTH — C permits duplicate enum values, so the
+ * shipped 26.2.0-rc3 driver had `sddepth` and `computeroundrobin` as the same
+ * bit, each enabling the other. Found 2026-08-03 while decoupling.
+ *
+ * ETK_GEAR_BIT(n) allocates 63, 62, 61 ... so the two allocators grow toward
+ * each other and can only meet in the middle, where it is obvious rather than
+ * silent. Upstream is at 37; there is room for ~14 more upstream flags and 4
+ * more ETK gears before they touch.
+ */
+
+#ifndef TU_ETK_GEARS_H
+#define TU_ETK_GEARS_H
+
+/* Nth ETK gear bit, counting down from the top of the u64. */
+#define ETK_GEAR_BIT(n) BITFIELD64_BIT(63 - (n))
+
+/* Expanded inside `enum tu_debug_flags` (tu_util.h). */
+#define ETK_DEBUG_FLAG_BITS                                                    \
+   /* LSD gears (FPS-recovery transmission) — lighter per-draw barriers than    \
+    * syncdraw; gated in tu6_emit_flushes. sdclean = depth-clean only (no       \
+    * waits); sdgate = depth-clean gated to depth-writing draws. */            \
+   TU_DEBUG_SDDEPTH    = ETK_GEAR_BIT(0),                                   \
+   TU_DEBUG_SDMEM      = ETK_GEAR_BIT(1),                                   \
+   TU_DEBUG_SDME       = ETK_GEAR_BIT(2),                                   \
+   TU_DEBUG_SDCLEAN    = ETK_GEAR_BIT(3),                                   \
+   TU_DEBUG_SDGATE     = ETK_GEAR_BIT(4),                                   \
+   /* Resolution-alignment investigation (Stage IV §5): dimlog instruments the  \
+    * GMEM render-target/bin dims + ragged remainder at tiling setup, and the   \
+    * zlatez hazard-state probe. Inert unless TU_DEBUG=dimlog. */               \
+   TU_DEBUG_DIMLOG     = ETK_GEAR_BIT(5),                                   \
+   /* Patch #3 "B": cap the a6xx depth CCU cache size at the RB_CCU_CNTL emit   \
+    * (FULL->HALF/QUARTER). FALSIFIED — smaller made it worse. Do not retry. */ \
+   TU_DEBUG_CCUHALF    = ETK_GEAR_BIT(6),                                   \
+   TU_DEBUG_CCUQUARTER = ETK_GEAR_BIT(7),                                   \
+   /* Patch #3 "A": route depth-storing (dsbypass) or ANY depth-attachment      \
+    * (dsany) renderpass to sysmem. FALSIFIED — the boss resolve is an internal \
+    * GMEM store, not a renderpass attachment resolve, so neither reaches it. */\
+   TU_DEBUG_DSBYPASS   = ETK_GEAR_BIT(8),                                   \
+   TU_DEBUG_DSANY      = ETK_GEAR_BIT(9),                                   \
+   /* Patch #7: widen upstream's A630/A650 EARLY_Z_LATE_Z hang workaround past  \
+    * its D32S8 format gate. zlatez adds D24_UNORM_S8_UINT (the ETK reference   \
+    * format, confirmed by the dimlog probe); zlatezany drops the format gate   \
+    * entirely. Gated in tu6_build_depth_plane_z_mode; A6XX-only. */            \
+   TU_DEBUG_ZLATEZ     = ETK_GEAR_BIT(10),                                   \
+   TU_DEBUG_ZLATEZANY  = ETK_GEAR_BIT(11),
+
+/* Expanded inside `tu_debug_options[]` (tu_util.cc), before the NULL sentinel. */
+#define ETK_DEBUG_OPTIONS                                                      \
+   { "sddepth",    TU_DEBUG_SDDEPTH },                                         \
+   { "sdmem",      TU_DEBUG_SDMEM },                                           \
+   { "sdme",       TU_DEBUG_SDME },                                            \
+   { "sdclean",    TU_DEBUG_SDCLEAN },                                         \
+   { "sdgate",     TU_DEBUG_SDGATE },                                          \
+   { "dimlog",     TU_DEBUG_DIMLOG },                                          \
+   { "ccuhalf",    TU_DEBUG_CCUHALF },                                         \
+   { "ccuquarter", TU_DEBUG_CCUQUARTER },                                      \
+   { "dsbypass",   TU_DEBUG_DSBYPASS },                                        \
+   { "dsany",      TU_DEBUG_DSANY },                                           \
+   { "zlatez",     TU_DEBUG_ZLATEZ },                                          \
+   { "zlatezany",  TU_DEBUG_ZLATEZANY },
+
+/* OR'd into `tu_runtime_debug_flags` (tu_util.cc). Every ETK gear is runtime-
+ * toggleable: they are all default-off diagnostics or opt-in barriers, none
+ * change state the driver captures at init. */
+#define ETK_RUNTIME_DEBUG_FLAGS                                                \
+   (TU_DEBUG_SDDEPTH | TU_DEBUG_SDMEM | TU_DEBUG_SDME | TU_DEBUG_SDCLEAN |     \
+    TU_DEBUG_SDGATE | TU_DEBUG_DIMLOG | TU_DEBUG_CCUHALF |                     \
+    TU_DEBUG_CCUQUARTER | TU_DEBUG_DSBYPASS | TU_DEBUG_DSANY |                 \
+    TU_DEBUG_ZLATEZ | TU_DEBUG_ZLATEZANY)
+
+#endif /* TU_ETK_GEARS_H */
diff --git a/src/freedreno/vulkan/tu_util.cc b/src/freedreno/vulkan/tu_util.cc
index 1fbf2dd..8bd541c 100644
--- a/src/freedreno/vulkan/tu_util.cc
+++ b/src/freedreno/vulkan/tu_util.cc
@@ -19,6 +19,8 @@
 #include "tu_pass.h"
 
 static const struct debug_control tu_debug_options[] = {
+   ETK_DEBUG_OPTIONS   /* fork gears (tu_etk_gears.h) — leading on purpose:
+                        * upstream appends, so a trailing anchor would move. */
    { "startup", TU_DEBUG_STARTUP },
    { "nir", TU_DEBUG_NIR },
    { "nobin", TU_DEBUG_NOBIN },
@@ -66,6 +68,7 @@ static const struct debug_control tu_debug_options[] = {
  * Note: Keep in sync with the list of flags in 'docs/drivers/freedreno.rst'.
  */
 const uint64_t tu_runtime_debug_flags =
+   ETK_RUNTIME_DEBUG_FLAGS |
    TU_DEBUG_NIR | TU_DEBUG_NOBIN | TU_DEBUG_SYSMEM | TU_DEBUG_GMEM |
    TU_DEBUG_FORCEBIN | TU_DEBUG_LAYOUT | TU_DEBUG_NOLRZ | TU_DEBUG_NOLRZFC |
    TU_DEBUG_PERF | TU_DEBUG_FLUSHALL | TU_DEBUG_SYNCDRAW |
@@ -352,6 +355,19 @@ tu_tiling_config_update_tile_layout(struct tu_framebuffer *fb,
          tiling->vsc.tile_count.height = 2;
       }
    }
+
+   /* ETK dimlog (Stage IV §5): one line per framebuffer/gmem-layout tiling
+    * setup. rem=0 means the render target tiles cleanly; a nonzero remainder is
+    * a ragged final bin. LRZ/UBWC alignment is derived offline from fb=. */
+   if (TU_DEBUG(DIMLOG) && tiling->possible) {
+      mesa_logi("[ETK dimlog] gmem_layout=%u fb=%ux%u tile0=%ux%u bins=%ux%u "
+                "rem=%ux%u tile_align=%ux%u",
+                gmem_layout, fb->width, fb->height,
+                tiling->tile0.width, tiling->tile0.height,
+                tiling->vsc.tile_count.width, tiling->vsc.tile_count.height,
+                fb->width % tiling->tile0.width, fb->height % tiling->tile0.height,
+                tile_align_w, tile_align_h);
+   }
 }
 
 static bool
