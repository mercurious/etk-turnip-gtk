---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 491ca4b..650e9de 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -1358,6 +1358,23 @@ use_sysmem_rendering(struct tu_cmd_buffer *cmd,
       return true;
    }
 
+   /* ETK Patch #3 "A" (dsbypass): selectively route only depth-STORING
+    * renderpasses to sysmem, to bypass the GMEM->sysmem depth resolve that
+    * wedges the HSL boss. Distinct from global SYSMEM: color-only passes stay
+    * on GMEM. Tests whether avoiding the GMEM depth resolve dodges the wedge,
+    * or whether the sysmem depth store-out hits the same CCU-resolve hazard. */
+   if (TU_DEBUG(DSBYPASS) && cmd->state.pass) {
+      for (uint32_t i = 0; i < cmd->state.pass->attachment_count; i++) {
+         const struct tu_render_pass_attachment *att =
+            &cmd->state.pass->attachments[i];
+         if (att->store && vk_format_has_depth(att->format)) {
+            cmd->state.rp.gmem_disable_reason =
+               "ETK dsbypass: depth-store pass -> sysmem";
+            return true;
+         }
+      }
+   }
+
    /* can't fit attachments into gmem */
    if (!cmd->state.tiling->possible) {
       cmd->state.rp.gmem_disable_reason = "Can't fit attachments into gmem";
